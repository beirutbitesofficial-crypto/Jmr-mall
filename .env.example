# Dedicated MySQL database; values are set in Hostinger's environment settings.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Enable if required by your database server; certificate verification stays enabled.
DB_SSL=false
# Optional: DATABASE_URL=mysql://user:encoded-password@host:3306/database
JMR_APP_PIN=
JMR_SESSION_SECRET=
# Exact HTTPS origin, no trailing slash, e.g. https://mall.example.com
APP_ORIGIN=
