# Initial setup account. Used only while the users table is empty.
JMR_ADMIN_USERNAME=admin
JMR_ADMIN_PASSWORD=

# Random secret, at least 32 characters. Rotating it invalidates all sessions.
JMR_SESSION_SECRET=

# Exact public origin, e.g. https://audit.example.com
APP_ORIGIN=

# Legacy fallback for first setup only. Prefer JMR_ADMIN_PASSWORD.
# JMR_APP_PIN=
